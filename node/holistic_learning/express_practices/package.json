{
  "name": "express_practices",
  "type": "module",
  "version": "1.0.0",
  "description": "the best express structure",
  "main": "index.js",
  "scripts": {
    "dev": "dotenvx run -- nodemon src/server.js",
    "dev-node": "node --env-file=.env --watch src/server.js",
    "seed": "dotenvx run -- node src/data/seed.js",
    "schema-update": "npx prisma generate",
    "init-database": "dotenvx run -- npx prisma migrate dev --name init"
  },
