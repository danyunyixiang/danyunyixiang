generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  birthday  DateTime
  group     String
  position  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
